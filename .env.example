# =============================================================================
# FlatWP Starter - Environment Configuration
# =============================================================================
# Copy this file to .env.local and update the values for your environment.
#
# REQUIRED variables must be set for the application to function.
# OPTIONAL variables have sensible defaults but can be customized.
# =============================================================================

# -----------------------------------------------------------------------------
# WordPress Connection (REQUIRED)
# -----------------------------------------------------------------------------

# The URL of your WordPress GraphQL endpoint
# This is your WordPress URL + /graphql
# Example: https://my-wordpress-site.com/graphql
NEXT_PUBLIC_WORDPRESS_API_URL=https://your-wordpress-site.com/graphql

# The domain of your WordPress site (for Next.js Image Optimization)
# Just the domain, no protocol or path
# Example: my-wordpress-site.com
NEXT_PUBLIC_WORDPRESS_DOMAIN=your-wordpress-site.com

# -----------------------------------------------------------------------------
# Security (REQUIRED)
# -----------------------------------------------------------------------------

# A secure random string for authenticating requests from WordPress
# Used for preview mode, revalidation webhooks, and form submissions
# MUST match the "API Secret" in your WordPress FlatWP plugin settings
# Generate with: openssl rand -base64 32
FLATWP_SECRET=your-secret-key-here

# -----------------------------------------------------------------------------
# Site Configuration (OPTIONAL)
# -----------------------------------------------------------------------------

# Your frontend site URL (defaults to http://localhost:3000 in development)
# Set this in production to your actual domain
# Example: https://demo.flatwp.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
